{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CAMS Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug CAMS Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "name": "CAMS Web UI"
    }
  ]
}
