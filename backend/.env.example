# CAMS Backend - example environment variables
# Copy this file to .env and set production values before running

# Database (PostgreSQL)
DATABASE_URL=postgresql://<db_user>:<db_pass>@localhost:5432/cams_db

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=cams_telemetry

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=replace-with-a-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120

# App
PROJECT_NAME=Consumer Attention Mapping System (CAMS)
API_V1_STR=/api/v1
